# Existing shared DevArena Supabase project; use the same project as the frontend.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Local only. The app refuses to boot with this on when NODE_ENV=production.
DEV_BYPASS_AUTH=false
DEV_USER_ID=

FRONTEND_ORIGIN=http://localhost:3001
PORT=3000
