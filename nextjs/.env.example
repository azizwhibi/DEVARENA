NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Marketplace stays closed unless one of these is exactly true.
# MOCK uses the in-browser demo and does not call the Nest marketplace routes.
# ENABLED calls the Nest API through api.http.ts. If both are true, MOCK wins.
# If neither is true, the header link is hidden and the pages show "Bientôt disponible".
NEXT_PUBLIC_MARKETPLACE_MOCK=false
NEXT_PUBLIC_MARKETPLACE_ENABLED=false
