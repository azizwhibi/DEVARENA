# Dedicated DEV project only; psql/pg_dump use standard PostgreSQL env variables.
# Set a real ref and credentials in ignored supabase/.env, never in source control.
DEV_PROJECT_REF=
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=verify-full
# Optional directory containing psql and pg_dump (Windows PostgreSQL installation).
PG_BIN=C:/Program Files/PostgreSQL/16/bin
